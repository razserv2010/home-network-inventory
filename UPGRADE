#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)

if [ "$(id -u)" -eq 0 ]; then
  echo 'Run as your regular user, without sudo.' >&2
  exit 1
fi
if ! command -v git >/dev/null || ! git -C "$project_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo 'This installation must be cloned with git to use UPGRADE.' >&2
  exit 1
fi
if [ -n "$(git -C "$project_dir" status --porcelain --untracked-files=no)" ]; then
  echo 'Local changes to project files detected. Save or discard them before updating.' >&2
  exit 1
fi

echo 'Downloading the latest project files...'
git -C "$project_dir" pull --ff-only
echo 'Installing the update and restarting the service...'
bash "$project_dir/install.sh"
